<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:RadioApp.Maui"
             xmlns:components="clr-namespace:RadioApp.Maui.Components"
             x:Class="RadioApp.Maui.MainPage"
             BackgroundColor="#07080C"
             NavigationPage.HasNavigationBar="False">

    <BlazorWebView x:Name="blazorWebView"
                   HostPage="wwwroot/index.html"
                   BackgroundColor="#07080C"
                   BlazorWebViewInitialized="OnBlazorWebViewInitialized">
        <BlazorWebView.RootComponents>
            <RootComponent Selector="#app" ComponentType="{x:Type components:Routes}" />
        </BlazorWebView.RootComponents>
    </BlazorWebView>

</ContentPage>
