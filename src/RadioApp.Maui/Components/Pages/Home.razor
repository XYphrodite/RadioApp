@page "/"
@implements IAsyncDisposable
@inject RadioBroadcastEngine Engine
@inject UserRadioStore Store
@inject ITailscaleBridge Tailscale
@inject IMediaSessionBridge MediaBridge
@inject HttpClient Http
@inject IJSRuntime JS

<div class="ambient-bg"></div>
<div class="scanlines"></div>

<div class="app-shell @(IsPlayerMode ? "player-mode" : "")" @onclick="ClosePopoverIfOpen">
    <!-- TOP BAR -->
    <header class="topbar">
        <div class="brand">
            <span class="live-dot @GetLiveDotClass()"></span>
            <span class="brand-title">@(IsPlayerMode ? "RadioWork // Player" : "RadioWork // FM")</span>
            <span class="brand-sub">
                @(_isOnline ? $"{(IsPlayerMode ? "Медиаплеер" : "Прямой эфир")} · {GetServerHostLabel()}" : "Ожидание сигнала эфир-сервера...")
            </span>
        </div>

        <div class="topbar-right">
            <div class="sort-tabs mode-switch" @onclick:stopPropagation="true" title="Режим работы приложения">
                <button class="sort-tab @(!IsPlayerMode ? "active" : "")" @onclick='() => SetAppModeAsync("radio")'>📻 Радио</button>
                <button class="sort-tab @(IsPlayerMode ? "active" : "")" @onclick='() => SetAppModeAsync("player")'>🎵 Плеер</button>
            </div>

            @if (Engine.IsLoaded)
            {
                <span class="stat-pill hide-mobile">
                    @FormatInt(Engine.Stats.TotalTracks) треков · @FormatInt(Engine.Stats.TotalArtists) артистов · @Engine.Stats.TotalHours ч
                </span>
            }
            <span class="stat-pill hide-xs">@_clockText</span>

            @if (!IsPlayerMode)
            {
                <button class="btn-ghost" @onclick="ToggleWheel" @onclick:stopPropagation="true" title="Круговое меню выбора волны как в GTA [Q]">
                    ◎ <span class="hide-xs">Колесо станций</span><span class="show-xs">Волны</span>
                    @if (!IsAndroid)
                    {
                        <span class="kbd">Q</span>
                    }
                </button>
            }

            <button class="btn-ghost" @onclick="ToggleServerPopover" @onclick:stopPropagation="true" title="Настройки подключения и Tailscale">
                ⚙
            </button>

            @if (_serverPopoverOpen)
            {
                <div class="server-popover" @onclick:stopPropagation="true">
                    <div class="popover-title">
                        <span>ЭФИР-СЕРВЕР АУДИОТЕКИ</span>
                        <span style="color: @(_isOnline ? "#19f086" : "#ff4d6d")">
                            @(_isOnline ? "● ONLINE" : "● OFFLINE")
                        </span>
                    </div>

                    <input class="server-input"
                           type="text"
                           placeholder="http://mks68i7rtx:5480"
                           @bind="_serverUrlInput"
                           @bind:event="oninput" />

                    @if (!string.IsNullOrEmpty(_connectionError))
                    {
                        <div class="popover-err">@_connectionError</div>
                    }

                    <div class="popover-actions">
                        <button class="btn-ctrl" @onclick="ApplyServerUrlAsync" disabled="@_isLoadingCatalog">
                            @(_isLoadingCatalog ? "Подключение..." : "↻ Подключить")
                        </button>

                        @if (Store.Preferences.BannedTrackIds.Count > 0)
                        {
                            <button class="btn-ctrl" @onclick="ClearBansAsync" title="Вернуть забаненные треки в ротацию">
                                Сброс банов (@Store.Preferences.BannedTrackIds.Count)
                            </button>
                        }
                    </div>

                    @if (Tailscale.IsSupported)
                    {
                        <div class="popover-divider"></div>

                        <div class="popover-title">
                            <span>ВШИТЫЙ TAILSCALE (БЕЗ VPN-СЛОТА)</span>
                            <span style="color: @(Tailscale.IsConnected ? "#19f086" : (_awaitingBrowserLogin ? "#ff9f1c" : "#a5aec4"))">
                                @(Tailscale.IsConnected ? "● ТУННЕЛЬ АКТИВЕН" : (_awaitingBrowserLogin ? "● ЖДЁМ ВХОД" : "● ВЫКЛ"))
                            </span>
                        </div>

                        <div class="ts-subtext">
                            Работает внутри приложения поверх Happ / системного VPN.
                        </div>

                        @if (Tailscale.IsConnected)
                        {
                            <div class="ts-connected-box">
                                <div>
                                    <div class="ts-connected-main">
                                        @(string.IsNullOrEmpty(Tailscale.LoginName) ? "Tailnet подключён" : Tailscale.LoginName)
                                    </div>
                                    @if (!string.IsNullOrEmpty(Tailscale.TargetDisplay))
                                    {
                                        <div class="ts-connected-sub">Мост → @Tailscale.TargetDisplay</div>
                                    }
                                </div>
                                <button class="btn-ctrl" @onclick="LogoutTailscaleAsync" disabled="@Tailscale.IsBusy">
                                    Выйти
                                </button>
                            </div>
                        }
                        else
                        {
                            <div class="popover-actions">
                                <button class="btn-ts-primary"
                                        @onclick="StartTailscaleBrowserLoginAsync"
                                        disabled="@Tailscale.IsBusy">
                                    @(Tailscale.IsBusy ? "Подготовка входа..." : "🔑 Войти в Tailscale")
                                </button>

                                <button class="btn-ctrl"
                                        @onclick="() => _showAuthKeyInput = !_showAuthKeyInput"
                                        title="Подключиться по ключу tskey-auth-...">
                                    Ключ
                                </button>
                            </div>

                            @if (_awaitingBrowserLogin && !string.IsNullOrEmpty(Tailscale.AuthUrl))
                            {
                                <div class="ts-login-wait">
                                    <span>Подтверди вход в открывшемся браузере — радио подключится само.</span>
                                    <button class="btn-ctrl" @onclick="OpenAuthUrlAgainAsync">Открыть ссылку</button>
                                </div>
                            }

                            @if (_showAuthKeyInput)
                            {
                                <input class="server-input"
                                       type="password"
                                       placeholder="tskey-auth-..."
                                       @bind="_authKeyInput"
                                       @bind:event="oninput" />
                                <button class="btn-ctrl"
                                        @onclick="ConnectTailscaleAuthKeyAsync"
                                        disabled="@Tailscale.IsBusy">
                                    Подключить по Auth Key
                                </button>
                            }
                        }

                        @if (!string.IsNullOrEmpty(Tailscale.LastError))
                        {
                            <div class="popover-err">@Tailscale.LastError</div>
                        }
                    }
                </div>
            }
        </div>
    </header>

    <!-- MAIN WORKSPACE -->
    @if (!IsPlayerMode)
    {
        <main class="workspace">
            <!-- LEFT: FM RECEIVER -->
            <section class="receiver-col">
            <!-- FM ANALOG/DIGITAL SCALE -->
            <div class="tuner-box">
                <div class="tuner-header">
                    <span class="tuner-hint">FM BAND 87.5 — 108.0 MHz <span class="hide-xs">· ПОТЯНИ ШКАЛУ ИЛИ КРУТИ КОЛЕСО</span></span>
                    <span>@(_isOnline ? "SIGNAL 99% · RDS" : "SEARCHING...")</span>
                </div>
                <div class="tuner-scale" id="tunerScale">
                    <div class="tuner-ticks">
                        @for (double f = 88.0; f <= 108.0; f += 0.5)
                        {
                            bool isMajor = Math.Abs(f % 2.0) < 0.01;
                            string leftPct = FreqToPctCss(f);
                            <div class="tick @(isMajor ? "major" : "minor")" style="left: @leftPct"></div>
                            @if (isMajor)
                            {
                                <div class="tick-label" style="left: @leftPct">@((int)f)</div>
                            }
                        }

                        @foreach (var st in _allStations)
                        {
                            bool isAct = string.Equals(st.Name, _activeStation?.Name, StringComparison.OrdinalIgnoreCase);
                            <div class="station-pip @(isAct ? "active" : "")"
                                 style="left: @FreqToPctCss(st.FrequencyMhz); background: @st.AccentHex; color: @st.AccentHex;"
                                 title="@($"{st.FrequencyMhz.ToString("0.0", CultureInfo.InvariantCulture)} FM — {st.Name}")"
                                 @onclick="() => TuneToStationAsync(st.Name)"
                                 @onclick:stopPropagation="true">
                            </div>
                        }

                        @if (_activeStation is not null)
                        {
                            <div class="tuner-needle" style="left: @FreqToPctCss(_activeStation.FrequencyMhz)"></div>
                        }
                    </div>
                </div>
            </div>

            <!-- NOW BROADCASTING HERO -->
            <div class="deck-card">
                <div class="tuning-overlay" id="tuningFlash"></div>

                @if (!_isOnline && !Engine.IsLoaded)
                {
                    <div class="offline-banner">
                        <div class="offline-banner-text">
                            @if (Tailscale.IsSupported && !Tailscale.IsConnected)
                            {
                                <div>
                                    <strong>Нужен доступ к эфир-серверу (@Store.Preferences.ServerBaseUrl)</strong>
                                    <div class="offline-sub">
                                        Войди во вшитый Tailscale один раз — он работает одновременно с Happ VPN без отключения твоего VPN.
                                    </div>
                                </div>
                            }
                            else
                            {
                                <span>Нет связи с сервером фонотеки (<strong>@Store.Preferences.ServerBaseUrl</strong>). Автоповтор каждые 5 сек...</span>
                            }
                        </div>

                        <div class="offline-actions">
                            @if (Tailscale.IsSupported && !Tailscale.IsConnected)
                            {
                                <button class="btn-ts-primary"
                                        @onclick="StartTailscaleBrowserLoginAsync"
                                        disabled="@Tailscale.IsBusy">
                                    @(Tailscale.IsBusy ? "Запуск Tailscale..." : (_awaitingBrowserLogin ? "🔑 Открыть вход снова" : "🔑 Войти в Tailscale"))
                                </button>
                            }
                            <button class="btn-ctrl" @onclick="() => ReloadCatalogAsync(showSpinner: true)">Повторить</button>
                        </div>
                    </div>
                }

                @if (_activeStation is { } active)
                {
                    var tr = active.CurrentTrack;
                    bool showCover = !_coverFailedTrackIds.Contains(tr.Id) &&
                                     (!IsAndroid || _readyCoverTrackId == tr.Id);

                    <div class="deck-top">
                        <div>
                            <div class="station-freq-row">
                                <span class="freq-big">@active.FrequencyMhz.ToString("0.0", CultureInfo.InvariantCulture)</span>
                                <span class="freq-unit">MHz FM</span>
                            </div>
                            <div class="station-name-big">@active.Name</div>
                            <div class="station-format">@active.Format</div>
                        </div>

                        <div class="rds-badges">
                            <span class="rds-tag hi">@(string.IsNullOrWhiteSpace(tr.Genre) ? active.Format : tr.Genre)</span>
                            <span class="rds-tag">@tr.CodecBadge</span>
                            <span class="rds-tag">@tr.BpmRounded BPM</span>
                            <span class="rds-tag">ENERGY @tr.EnergyPercent%</span>
                        </div>
                    </div>

                    <div class="now-playing-stage">
                        <div class="vinyl-wrap">
                            <div class="vinyl-disc @(Store.Preferences.PowerOn ? "" : "paused")">
                                <div class="vinyl-grooves"></div>
                                @if (showCover)
                                {
                                    <img class="vinyl-cover"
                                         @key="tr.Id"
                                         src="@Engine.GetCoverUrl(tr)"
                                         decoding="async"
                                         alt=""
                                         @onerror="() => OnCoverLoadError(tr.Id)" />
                                    <div class="vinyl-spindle"></div>
                                }
                            </div>
                            @if (!showCover)
                            {
                                <div class="vinyl-emblem">@active.Icon</div>
                            }
                        </div>

                        <div class="track-meta">
                            <div class="on-air-eyebrow">
                                <span>● СЕЙЧАС В ЭФИРЕ</span>
                                <span>· @FormatInt(active.TotalTrackCount) треков</span>
                            </div>
                            <div class="track-title" title="@tr.DisplayTitle">@tr.DisplayTitle</div>
                            <div class="track-artist" title="@tr.Artist">@tr.Artist</div>
                            <div class="track-album" title="@tr.Album">@tr.Album</div>

                            <div class="broadcast-bar-wrap" title="Эфир идёт в реальном времени одновременно на всех 11 станциях">
                                <div class="broadcast-times">
                                    <span>@FormatTime(active.ElapsedSec)</span>
                                    <span class="no-scrub-hint">🔒 Прямой эфир <span class="hide-xs">— перемотка отключена</span></span>
                                    <span>@FormatTime(active.DurationSec)</span>
                                </div>
                                <div class="broadcast-progress-track">
                                    <div class="broadcast-progress-fill"
                                         style="width: @(active.ProgressPercent.ToString("0.0", CultureInfo.InvariantCulture))%">
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="deck-placeholder">
                        @(_isLoadingCatalog || Tailscale.IsBusy
                            ? "ПОДКЛЮЧЕНИЕ К ЭФИР-СЕРВЕРУ РАДИОСТАНЦИЙ..."
                            : "ОЖИДАНИЕ СИГНАЛА РАДИОСЕРВЕРА")
                    </div>
                }

                <div class="spectrum-wrap">
                    <canvas id="spectrumCanvas" width="900" height="46"></canvas>
                </div>
            </div>

            <!-- CONTROLS BAR -->
            <div class="controls-bar">
                <div class="transport-group">
                    <button class="btn-power @(Store.Preferences.PowerOn ? "" : "off")"
                            @onclick="TogglePowerAsync"
                            title="Включить / приглушить приёмник (эфир продолжает идти!) [Space]">
                        <svg class="power-ico" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
                            <path d="M12 3v8" />
                            <path d="M17.66 6.34a8 8 0 1 1-11.32 0" />
                        </svg>
                        <span>@(Store.Preferences.PowerOn ? "В ЭФИРЕ" : "MUTE")</span>
                    </button>
                    <button class="btn-ctrl" @onclick="() => StepFrequencyAsync(-1)" title="Предыдущая частота [←]">⏮ Волна −</button>
                    <button class="btn-ctrl" @onclick="() => StepFrequencyAsync(1)" title="Следующая частота [→]">Волна + ⏭</button>
                    <button class="btn-ctrl" @onclick="SkipTrackWithStaticAsync" title="Сбросить текущий трек на волне через радиопомеху">⚡ Помехи</button>
                </div>

                <div class="feedback-group">
                    @{
                        bool isLiked = _activeStation is not null && Engine.IsTrackLiked(_activeStation.CurrentTrack.Id);
                    }
                    <button class="btn-ctrl @(isLiked ? "liked" : "")"
                            @onclick="ToggleLikeCurrentTrack"
                            title="Повысить вес трека (2x) в ротации станции">
                        ♥ Чаще в эфире
                    </button>
                    <button class="btn-ctrl"
                            @onclick="BanCurrentTrackAsync"
                            title="Навсегда убрать этот трек из эфира станции">
                        ✕ В бан
                    </button>
                    @if (IsAndroid)
                    {
                        <button class="btn-ctrl" @onclick="ToggleStaticFxAsync" title="Звук FM-шороха при переключении волн">
                            📻 Шум: @(Store.Preferences.StaticFxEnabled ? "ВКЛ" : "ВЫКЛ")
                        </button>
                    }
                </div>

                @if (!IsAndroid)
                {
                    <div class="audio-group">
                        <button class="btn-ctrl" @onclick="ToggleStaticFxAsync" title="Звук FM-шороха при переключении волн">
                            📻 Шум: @(Store.Preferences.StaticFxEnabled ? "ВКЛ" : "ВЫКЛ")
                        </button>
                        <div class="vol-wrap">
                            <span>🔊</span>
                            <input type="range"
                                   class="vol-slider"
                                   min="0"
                                   max="100"
                                   value="@VolumePercent"
                                   @oninput="OnVolumeInputAsync" />
                            <span>@VolumePercent%</span>
                        </div>
                    </div>
                }
            </div>

            <!-- RECENT ON THIS FREQUENCY -->
            <div class="history-strip">
                <span class="history-label">Недавно на волне:</span>
                <div class="history-items">
                    @if (_activeStation is not null)
                    {
                        @foreach (var h in _activeStation.RecentHistory)
                        {
                            <div class="history-item">
                                <span class="history-time">@h.MinutesAgo мин назад</span>
                                <strong>@h.Track.Artist</strong> — @h.Track.DisplayTitle
                            </div>
                        }
                    }
                </div>
            </div>
        </section>

        <!-- RIGHT: ALL 11 STATIONS LIVE BOARD -->
        <aside class="stations-panel">
            <div class="panel-head">
                <span class="panel-title">Все @(_allStations.Count > 0 ? _allStations.Count : 11) станций (живой эфир)</span>
                <div class="sort-tabs">
                    <button class="sort-tab @(Store.Preferences.SortMode != "freq" ? "active" : "")"
                            @onclick='() => SetSortMode("count")'>
                        По базе
                    </button>
                    <button class="sort-tab @(Store.Preferences.SortMode == "freq" ? "active" : "")"
                            @onclick='() => SetSortMode("freq")'>
                        По MHz
                    </button>
                </div>
            </div>

            <div class="stations-list">
                @foreach (var st in _allStations)
                {
                    bool isAct = string.Equals(st.Name, _activeStation?.Name, StringComparison.OrdinalIgnoreCase);
                    <div class="st-card @(isAct ? "active" : "")"
                         style="--st-color: @st.AccentHex"
                         @onclick="() => TuneToStationAsync(st.Name)">
                        <div class="st-row-1">
                            <div class="st-title-wrap">
                                <span class="st-freq">@st.FrequencyMhz.ToString("0.0", CultureInfo.InvariantCulture)</span>
                                <span class="st-name">@st.Icon @st.Name</span>
                            </div>
                            <span class="st-count">@FormatInt(st.TotalTrackCount) тр.</span>
                        </div>
                        <div class="st-row-2">▶ @st.CurrentTrack.Artist — @st.CurrentTrack.DisplayTitle</div>
                        <div class="st-mini-bar">
                            <div class="st-mini-fill" style="width: @(st.ProgressPercent.ToString("0.0", CultureInfo.InvariantCulture))%"></div>
                        </div>
                    </div>
                }
            </div>
        </aside>
    </main>
}
else
{
    var pt = _playerTrack;
    bool showPlayerCover = pt is not null && !_coverFailedTrackIds.Contains(pt.Id);
    double shownPos = _isSeeking ? _seekPreview : _playerPos;
    int seekMax = (int)Math.Max(1, Math.Ceiling(_playerDur));
    double progressPct = Math.Clamp(seekMax > 0 ? (shownPos / (double)seekMax * 100.0) : 0.0, 0.0, 100.0);
    string progressStyle = $"--progress: {progressPct.ToString("0.0", CultureInfo.InvariantCulture)}%;";

    <!-- MAIN WORKSPACE: MEDIA PLAYER -->
    <main class="player-shell @(_libraryFullscreen ? "is-fullscreen" : "")">
        <!-- 1. ФОНОТЕКА (ОСНОВНАЯ ОБЛАСТЬ, РАЗВОРАЧИВАЕТСЯ НА ВЕСЬ ЭКРАН) -->
        <section class="player-library-panel">
            <div class="panel-head player-head">
                <div class="player-head-left">
                    <span class="panel-title">Фонотека</span>

                    <div class="player-view-tabs" role="group" aria-label="Вид фонотеки">
                        <button type="button"
                                class="player-view-tab @(_libraryView == "tracks" ? "active" : "")"
                                @onclick='() => SetLibraryView("tracks")'
                                title="Список треков">
                            🎵 Треки
                        </button>
                        <button type="button"
                                class="player-view-tab @(_libraryView == "artists" ? "active" : "")"
                                @onclick='() => SetLibraryView("artists")'
                                title="Список исполнителей">
                            👤 Артисты
                        </button>
                    </div>

                    <span class="player-count-badge">
                        @(_libraryView == "tracks" ? $"{FormatInt(_filteredTracks.Count)} тр." : $"{FormatInt(_cachedArtists.Count > 0 ? _cachedArtists.Count : GetAvailableArtistsCount())} арт.")
                    </span>
                </div>

                <div class="player-head-right">
                    <button class="btn-ctrl btn-fullscreen-toggle"
                            @onclick="ToggleLibraryFullscreen"
                            title="@(_libraryFullscreen ? "Свернуть в обычный вид" : "Развернуть фонотеку на весь экран")">
                        <span class="hide-xs">@(_libraryFullscreen ? "↙ Свернуть" : "⛶ Во весь экран")</span>
                        <span class="show-xs">@(_libraryFullscreen ? "↙" : "⛶")</span>
                    </button>
                </div>
            </div>

            <div class="player-filters">
                <div class="search-input-wrap">
                    <input class="server-input player-search-input"
                           type="text"
                           placeholder="@(_libraryView == "tracks" ? "🔎 Поиск: артист, трек, альбом" : "🔎 Поиск артиста...")"
                           value="@(_libraryView == "tracks" ? PlayerSearch : _artistSearchFilter)"
                           @oninput="OnUniversalSearchInput" />
                    @if (!string.IsNullOrEmpty(_libraryView == "tracks" ? _playerSearch : _artistSearchFilter))
                    {
                        <button class="search-clear-btn" @onclick="ClearUniversalSearch" title="Очистить поиск">✕</button>
                    }
                </div>

                <div class="player-filter-actions">
                    <select class="server-input player-select" @bind="PlayerStationFilter">
                        <option value="">Все волны (@FormatInt(Engine.LibraryTracks.Count) тр.)</option>
                        @foreach (var sn in Engine.StationNames)
                        {
                            <option value="@sn">@sn</option>
                        }
                    </select>

                    <div class="player-artist-picker-wrap">
                        <button type="button"
                                class="player-artist-btn @(!string.IsNullOrEmpty(_playerArtist) ? "has-selection" : "")"
                                @onclick="OpenArtistPicker"
                                title="Список артистов с быстрым поиском">
                            <span class="pab-left">
                                <span class="pab-icon">👤</span>
                                <span class="pab-text">
                                    @if (string.IsNullOrWhiteSpace(_playerArtist))
                                    {
                                        <span>Все артисты (@FormatInt(_cachedArtists.Count > 0 ? _cachedArtists.Count : GetAvailableArtistsCount()))</span>
                                    }
                                    else
                                    {
                                        <span class="pab-name">@_playerArtist</span>
                                        <span class="pab-count">(@FormatInt(GetArtistTrackCount(_playerArtist)) тр.)</span>
                                    }
                                </span>
                            </span>
                            <span class="pab-right">
                                <span class="pab-search-glyph">🔍</span>
                                <span class="pab-arrow">▾</span>
                            </span>
                        </button>
                        @if (!string.IsNullOrWhiteSpace(_playerArtist))
                        {
                            <button type="button"
                                    class="player-artist-clear-btn"
                                    @onclick="ClearPlayerArtist"
                                    title="Сбросить артиста">
                                ✕
                            </button>
                        }
                    </div>

                    @if (_libraryView == "tracks")
                    {
                        <div class="sort-tabs player-sort-tabs" title="Сортировка фонотеки">
                            <button class="sort-tab @(Store.Preferences.PlayerSortKey == "artist" ? "active" : "")"
                                    @onclick='() => ToggleSort("artist")'
                                    title="Сортировать по авторам (артистам)">
                                👤 Автор@(GetSortArrow("artist"))
                            </button>
                            <button class="sort-tab @(Store.Preferences.PlayerSortKey == "album" ? "active" : "")"
                                    @onclick='() => ToggleSort("album")'
                                    title="Сортировать по альбомам">
                                💿 Альбом@(GetSortArrow("album"))
                            </button>
                            <button class="sort-tab hide-xs @(Store.Preferences.PlayerSortKey == "title" ? "active" : "")"
                                    @onclick='() => ToggleSort("title")'
                                    title="Сортировать по названиям треков">
                                🎵 Трек@(GetSortArrow("title"))
                            </button>
                            @if (Store.Preferences.PlayerSortKey != "default")
                            {
                                <button class="sort-tab btn-reset-sort"
                                        @onclick="ResetSort"
                                        title="Сбросить сортировку (по каталогу)">
                                    ✕
                                </button>
                            }
                        </div>
                    }
                </div>
            </div>

            @if (_libraryView == "artists")
            {
                <div class="player-artist-catalog" role="list">
                    @{
                        var artistList = GetFilteredArtists().ToList();
                    }
                    @if (artistList.Count > 0)
                    {
                        @foreach (var a in artistList)
                        {
                            var isSel = string.Equals(_playerArtist, a.Name, StringComparison.OrdinalIgnoreCase);
                            <div class="player-artist-card @(isSel ? "active" : "")"
                                 role="button"
                                 tabindex="0"
                                 @onclick="() => SelectArtist(a.Name)">
                                <div class="pac-avatar">👤</div>
                                <div class="pac-info">
                                    <div class="pac-name">@a.Name</div>
                                    <div class="pac-sub">@FormatInt(a.TrackCount) треков в ротации</div>
                                </div>
                                <div class="pac-action">
                                    <span>Показать треки ›</span>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="deck-placeholder">
                            Исполнители не найдены по вашему запросу
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="player-tracks-list">
                    @foreach (var t in _filteredTracks.Take(_playerShown))
                    {
                        bool isCur = pt is not null && pt.Id == t.Id;
                        <div class="player-track-row @(isCur ? "active" : "")"
                             @key="t.Id"
                             @onclick="() => PlayFromListAsync(t)">
                            <div class="ptr-idx">
                                @if (isCur)
                                {
                                    <span class="ptr-eq @(Store.Preferences.PowerOn ? "playing" : "paused")">
                                        <span></span><span></span><span></span>
                                    </span>
                                }
                                else
                                {
                                    <span class="ptr-play-hint">▶</span>
                                }
                            </div>

                            <div class="ptr-info">
                                <div class="ptr-title" title="@t.DisplayTitle">@t.DisplayTitle</div>
                                <div class="ptr-sub" title="@t.Artist · @t.Album">
                                    <span class="ptr-artist @(Store.Preferences.PlayerSortKey == "artist" ? "sort-highlight" : "")"
                                          @onclick="() => FilterByArtistFromTrack(t.Artist)"
                                          @onclick:stopPropagation="true"
                                          title="Показать все треки этого исполнителя">@t.Artist</span>
                                    @if (!string.IsNullOrWhiteSpace(t.Album))
                                    {
                                        <span class="ptr-sep">·</span>
                                        <span class="ptr-album @(Store.Preferences.PlayerSortKey == "album" ? "sort-highlight" : "")">@t.Album</span>
                                    }
                                </div>
                            </div>

                            <div class="ptr-meta-right">
                                @if (!string.IsNullOrWhiteSpace(t.Genre))
                                {
                                    <span class="ptr-genre hide-xs">@t.Genre</span>
                                }
                                <span class="ptr-codec hide-xs">@t.CodecBadge</span>
                                <span class="ptr-time">@FormatTime(t.EffectiveDurationSec)</span>
                            </div>
                        </div>
                    }

                    @if (_filteredTracks.Count > _playerShown)
                    {
                        <button class="btn-ctrl player-more" @onclick="ShowMorePlayerTracks">
                            Показать ещё (@FormatInt(_filteredTracks.Count - _playerShown))
                        </button>
                    }
                    else if (_filteredTracks.Count == 0)
                    {
                        <div class="deck-placeholder">
                            @(Engine.IsLoaded ? "Ничего не найдено по вашему запросу" : "Каталог не загружен")
                        </div>
                    }
                </div>
            }
        </section>

        <!-- 2. СЕЙЧАС ИГРАЕТ (КОМПАКТНЫЙ ПЛЕЕР СНИЗУ) -->
        <footer class="player-bottom-dock">
            <div class="dock-scrub-row">
                <span class="dock-time dock-time-current">@FormatTime(shownPos)</span>
                <input type="range"
                       class="vol-slider dock-slider @(Store.Preferences.PowerOn ? "playing" : "paused")"
                       min="0"
                       max="@seekMax"
                       step="1"
                       value="@((int)shownPos)"
                       style="@progressStyle"
                       @oninput="OnSeekInput"
                       @onchange="OnSeekCommitAsync" />
                <span class="dock-time dock-time-total">@FormatTime(_playerDur)</span>
            </div>

            <div class="dock-content-row">
                <div class="dock-track-summary">
                    <div class="dock-cover-disc @(Store.Preferences.PowerOn ? "spinning" : "paused")">
                        @if (showPlayerCover && pt is not null)
                        {
                            <img class="dock-cover-img"
                                 @key="pt.Id"
                                 src="@Engine.GetCoverUrl(pt)"
                                 decoding="async"
                                 alt=""
                                 @onerror="() => OnCoverLoadError(pt.Id)" />
                            <div class="dock-cover-center"></div>
                        }
                        else
                        {
                            <span class="dock-cover-icon">🎵</span>
                        }
                    </div>

                    <div class="dock-track-text">
                        @if (pt is not null)
                        {
                            <div class="dock-title" title="@pt.DisplayTitle">@pt.DisplayTitle</div>
                            <div class="dock-sub" title="@pt.Artist · @pt.Album">
                                <span class="dock-artist">@pt.Artist</span>
                                @if (!string.IsNullOrWhiteSpace(pt.Album))
                                {
                                    <span class="dock-sep">·</span>
                                    <span class="dock-album">@pt.Album</span>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="dock-title">Фонотека готова</div>
                            <div class="dock-sub">Выберите трек из списка выше</div>
                        }
                    </div>
                </div>

                <div class="dock-controls">
                    <button class="btn-dock-btn hide-xs @(Store.Preferences.PlayerShuffle ? "liked" : "")"
                            @onclick="TogglePlayerShuffle"
                            title="Случайный порядок (Shuffle)">
                        🔀
                    </button>
                    <button class="btn-dock-btn"
                            @onclick="() => PlayerStepAsync(-1)"
                            title="Предыдущий трек [←]">
                        ⏮
                    </button>
                    <button class="btn-dock-play @(Store.Preferences.PowerOn ? "playing" : "paused")"
                            @onclick="TogglePowerAsync"
                            title="Воспроизведение / Пауза [Space]">
                        @(Store.Preferences.PowerOn ? "⏸" : "▶")
                    </button>
                    <button class="btn-dock-btn"
                            @onclick="() => PlayerStepAsync(1)"
                            title="Следующий трек [→]">
                        ⏭
                    </button>
                    <button class="btn-dock-btn hide-xs @(Store.Preferences.PlayerRepeat != "off" ? "liked" : "")"
                            @onclick="CyclePlayerRepeat"
                            title="@(Store.Preferences.PlayerRepeat switch { "one" => "Повтор одного трека", "all" => "Повтор всей очереди", _ => "Повтор выключен" })">
                        @(Store.Preferences.PlayerRepeat switch { "one" => "🔂", _ => "🔁" })
                    </button>
                </div>

                @if (!IsAndroid)
                {
                    <div class="dock-actions">
                        <div class="dock-vol hide-mobile">
                            <span>🔊</span>
                            <input type="range"
                                   class="vol-slider dock-vol-slider"
                                   min="0"
                                   max="100"
                                   value="@VolumePercent"
                                   @oninput="OnVolumeInputAsync" />
                        </div>
                    </div>
                }
            </div>
        </footer>
    </main>

    <!-- SEARCHABLE ARTIST PICKER MODAL -->
    @if (_artistPickerOpen)
    {
        <div class="artist-picker-backdrop" @onclick="CloseArtistPicker">
            <div class="artist-picker-sheet" @onclick:stopPropagation="true">
                <header class="artist-picker-header">
                    <div class="artist-picker-title">
                        <span class="api-header-icon">👤</span>
                        <span class="api-header-title-text">Исполнители</span>
                        <span class="player-count-badge">@FormatInt(_cachedArtists.Count > 0 ? _cachedArtists.Count : GetAvailableArtistsCount())</span>
                    </div>
                    <button type="button" class="artist-picker-close-btn" @onclick="CloseArtistPicker" title="Закрыть">✕</button>
                </header>

                <div class="artist-picker-search-bar">
                    <span class="search-icon">🔍</span>
                    <input type="search"
                           class="server-input artist-search-field"
                           placeholder="Быстрый поиск артиста..."
                           value="@_artistSearchFilter"
                           @oninput="OnArtistSearchInput"
                           autofocus />
                    @if (!string.IsNullOrWhiteSpace(_artistSearchFilter))
                    {
                        <button type="button" class="search-clear-btn" @onclick="ClearArtistSearch" title="Очистить">✕</button>
                    }
                </div>

                <div class="artist-picker-list">
                    <button type="button"
                            class="artist-picker-item @(string.IsNullOrEmpty(_playerArtist) ? "is-selected" : "")"
                            @onclick="() => SelectArtist(null)">
                        <span class="api-item-main">
                            <span class="api-item-bullet">✦</span>
                            <span class="api-item-name">Все исполнители</span>
                        </span>
                        <span class="api-item-badge">@FormatInt(GetTotalTracksInScope()) тр.</span>
                    </button>

                    @{
                        var list = GetFilteredArtists().ToList();
                    }
                    @foreach (var a in list)
                    {
                        var isSelected = string.Equals(_playerArtist, a.Name, StringComparison.OrdinalIgnoreCase);
                        <button type="button"
                                class="artist-picker-item @(isSelected ? "is-selected" : "")"
                                @onclick="() => SelectArtist(a.Name)">
                            <span class="api-item-main">
                                <span class="api-item-bullet">👤</span>
                                <span class="api-item-name">@a.Name</span>
                            </span>
                            <span class="api-item-badge">@FormatInt(a.TrackCount) тр.</span>
                        </button>
                    }

                    @if (list.Count == 0)
                    {
                        <div class="artist-picker-empty">
                            <span>Ничего не найдено по запросу «@_artistSearchFilter»</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
}
</div>

<!-- GTA-INSPIRED RADIAL WHEEL OVERLAY -->
<div class="wheel-backdrop @(_wheelOpen ? "open" : "")" @onclick="CloseWheelFromBackdrop">
    <div class="wheel-container" @onclick:stopPropagation="true">
        @{
            var wheelFocus = _hoveredWheelStation ?? _activeStation;
        }
        <div class="wheel-center">
            @if (wheelFocus is not null)
            {
                <div style="font-family: var(--mono); font-size: 13px; color: @wheelFocus.AccentHex;">
                    @wheelFocus.FrequencyMhz.ToString("0.0", CultureInfo.InvariantCulture) FM
                </div>
                <div style="font-size: 20px; font-weight: 800; margin-top: 3px;">@wheelFocus.Name</div>
                <div style="font-size: 12px; color: var(--text-1); margin-top: 8px;">
                    @wheelFocus.CurrentTrack.Artist — @wheelFocus.CurrentTrack.DisplayTitle
                </div>
            }
            <div style="font-family: var(--mono); font-size: 10.5px; color: var(--text-2); margin-top: 12px;">
                Выбери станцию
            </div>
        </div>

        @for (int i = 0; i < _allStations.Count; i++)
        {
            var st = _allStations[i];
            double angle = (i / (double)_allStations.Count) * Math.PI * 2.0 - Math.PI / 2.0;
            double x = 290.0 + Math.Cos(angle) * 228.0;
            double y = 290.0 + Math.Sin(angle) * 228.0;
            bool isAct = string.Equals(st.Name, _activeStation?.Name, StringComparison.OrdinalIgnoreCase);

            <div class="wheel-node @(isAct ? "active" : "")"
                 style="left: @(x.ToString("0.0", CultureInfo.InvariantCulture))px; top: @(y.ToString("0.0", CultureInfo.InvariantCulture))px; --node-color: @st.AccentHex;"
                 @onmouseenter="() => _hoveredWheelStation = st"
                 @onclick="() => SelectFromWheelAsync(st.Name)">
                <div class="wheel-node-icon">@st.Icon</div>
                <div class="wheel-node-freq">@st.FrequencyMhz.ToString("0.0", CultureInfo.InvariantCulture)</div>
                <div class="wheel-node-name">@st.Name</div>
            </div>
        }
    </div>
</div>

@code {
    private const double FreqMin = 87.5;
    private const double FreqMax = 108.0;
    private static readonly bool IsAndroid = OperatingSystem.IsAndroid();

    private DotNetObjectReference<Home>? _dotNetRef;
    private CancellationTokenSource? _tickCts;
    private CancellationTokenSource? _coverDelayCts;

    private IReadOnlyList<StationLiveState> _allStations = [];
    private StationLiveState? _activeStation;
    private StationLiveState? _hoveredWheelStation;
    private readonly HashSet<int> _coverFailedTrackIds = new();

    private string _clockText = DateTime.Now.ToString("HH:mm:ss");
    private string _serverUrlInput = "";
    private string _authKeyInput = "";
    private string? _connectionError;
    private bool _isOnline;
    private bool _isLoadingCatalog;
    private bool _wheelOpen;
    private bool _serverPopoverOpen;
    private bool _showAuthKeyInput;
    private bool _awaitingBrowserLogin;
    private bool _pollingTailscale;
    private bool _jsInitialized;
    private int _lastSyncedTrackId = -1;
    private string _lastSyncedStation = "";
    private string _lastSyncedBaseUrl = "";
    private int _lastPreloadedTrackId = -1;
    private int _readyCoverTrackId = -1;
    private int _scheduledCoverTrackId = -1;
    private int _offlineRetryTicks;
    private int _tsPollTicks;

    private int VolumePercent => (int)Math.Round(Store.Preferences.Volume * 100.0);
    private double EffectiveVolume => IsAndroid ? 1.0 : Store.Preferences.Volume;

    // ───────────── Media-player mode state ─────────────
    private const int PlayerPageSize = 120;
    private const string PlayerAccent = "#19e68c";

    private bool IsPlayerMode => string.Equals(Store.Preferences.AppMode, "player", StringComparison.OrdinalIgnoreCase);

    private bool _libraryFullscreen;

    private void ToggleLibraryFullscreen()
    {
        _libraryFullscreen = !_libraryFullscreen;
    }

    private void ClearPlayerSearch()
    {
        PlayerSearch = "";
    }

    private List<RadioTrack> _filteredTracks = new();
    private List<RadioTrack> _playerQueue = new();
    private RadioTrack? _playerTrack;
    private int _playerIndex = -1;
    private double _playerPos;
    private double _playerDur;
    private bool _isSeeking;
    private double _seekPreview;
    private int _playerShown = PlayerPageSize;
    private string _playerSearch = "";
    private string _playerStation = "";

    private sealed class PlayerPosition
    {
        public double Pos { get; set; }
        public double Dur { get; set; }
        public bool Paused { get; set; }
    }

    private string PlayerSearch
    {
        get => _playerSearch;
        set
        {
            _playerSearch = value ?? "";
            _playerShown = PlayerPageSize;
            RebuildPlayerList();
        }
    }

    private string PlayerStationFilter
    {
        get => _playerStation;
        set
        {
            _playerStation = value ?? "";
            _playerShown = PlayerPageSize;
            RebuildAvailableArtists();
            if (!string.IsNullOrEmpty(_playerArtist) && !_cachedArtists.Any(a => string.Equals(a.Name, _playerArtist, StringComparison.OrdinalIgnoreCase)))
            {
                _playerArtist = "";
            }
            RebuildPlayerList();
        }
    }

    public sealed record PlayerArtistItem(string Name, int TrackCount);

    private string _playerArtist = "";
    private bool _artistPickerOpen;
    private string _artistSearchFilter = "";
    private string _libraryView = "tracks"; // "tracks" or "artists"
    private List<PlayerArtistItem> _cachedArtists = new();

    private void RebuildAvailableArtists()
    {
        if (!Engine.IsLoaded)
        {
            _cachedArtists = new();
            return;
        }

        IEnumerable<RadioTrack> q = Engine.LibraryTracks;
        if (!string.IsNullOrEmpty(_playerStation))
        {
            q = q.Where(t => string.Equals(t.Station, _playerStation, StringComparison.OrdinalIgnoreCase));
        }

        _cachedArtists = q
            .Select(t => string.IsNullOrWhiteSpace(t.Artist) ? "Неизвестный исполнитель" : t.Artist.Trim())
            .GroupBy(a => a, StringComparer.OrdinalIgnoreCase)
            .Select(g => new PlayerArtistItem(g.Key, g.Count()))
            .OrderBy(a => a.Name, StringComparer.CurrentCultureIgnoreCase)
            .ToList();
    }

    private int GetAvailableArtistsCount()
    {
        if (_cachedArtists.Count == 0 && Engine.IsLoaded)
            RebuildAvailableArtists();
        return _cachedArtists.Count;
    }

    private int GetTotalTracksInScope()
    {
        if (!Engine.IsLoaded) return 0;
        if (string.IsNullOrEmpty(_playerStation)) return Engine.LibraryTracks.Count;
        return Engine.LibraryTracks.Count(t => string.Equals(t.Station, _playerStation, StringComparison.OrdinalIgnoreCase));
    }

    private IEnumerable<PlayerArtistItem> GetFilteredArtists()
    {
        if (_cachedArtists.Count == 0 && Engine.IsLoaded)
            RebuildAvailableArtists();

        if (string.IsNullOrWhiteSpace(_artistSearchFilter))
            return _cachedArtists;

        return _cachedArtists.Where(a =>
            a.Name.Contains(_artistSearchFilter.Trim(), StringComparison.CurrentCultureIgnoreCase));
    }

    private int GetArtistTrackCount(string artist)
    {
        if (_cachedArtists.Count == 0 && Engine.IsLoaded)
            RebuildAvailableArtists();

        var item = _cachedArtists.FirstOrDefault(a => string.Equals(a.Name, artist, StringComparison.OrdinalIgnoreCase));
        return item?.TrackCount ?? 0;
    }

    private void OpenArtistPicker()
    {
        _artistSearchFilter = "";
        _artistPickerOpen = true;
    }

    private void CloseArtistPicker()
    {
        _artistPickerOpen = false;
        _artistSearchFilter = "";
    }

    private void SelectArtist(string? artist)
    {
        _playerArtist = artist?.Trim() ?? "";
        _artistPickerOpen = false;
        _artistSearchFilter = "";
        _playerShown = PlayerPageSize;
        _libraryView = "tracks";
        RebuildPlayerList();
    }

    private void ClearPlayerArtist()
    {
        _playerArtist = "";
        _playerShown = PlayerPageSize;
        RebuildPlayerList();
    }

    private void FilterByArtistFromTrack(string? artist)
    {
        if (!string.IsNullOrWhiteSpace(artist))
        {
            SelectArtist(artist);
        }
    }

    private void OnArtistSearchInput(ChangeEventArgs e)
    {
        _artistSearchFilter = e.Value?.ToString() ?? "";
    }

    private void ClearArtistSearch()
    {
        _artistSearchFilter = "";
    }

    private void SetLibraryView(string view)
    {
        _libraryView = view;
    }

    private void OnUniversalSearchInput(ChangeEventArgs e)
    {
        var val = e.Value?.ToString() ?? "";
        if (_libraryView == "artists")
        {
            _artistSearchFilter = val;
        }
        else
        {
            PlayerSearch = val;
        }
    }

    private void ClearUniversalSearch()
    {
        if (_libraryView == "artists")
        {
            _artistSearchFilter = "";
        }
        else
        {
            ClearPlayerSearch();
        }
    }

    private void ToggleSort(string key)
    {
        if (Store.Preferences.PlayerSortKey == key)
        {
            Store.Preferences.PlayerSortAsc = !Store.Preferences.PlayerSortAsc;
        }
        else
        {
            Store.Preferences.PlayerSortKey = key;
            Store.Preferences.PlayerSortAsc = true;
        }
        Store.Save();
        _playerShown = PlayerPageSize;
        RebuildPlayerList();
    }

    private void ResetSort()
    {
        Store.Preferences.PlayerSortKey = "default";
        Store.Preferences.PlayerSortAsc = true;
        Store.Save();
        _playerShown = PlayerPageSize;
        RebuildPlayerList();
    }

    private string GetSortArrow(string key)
    {
        if (Store.Preferences.PlayerSortKey != key)
            return "";
        return Store.Preferences.PlayerSortAsc ? " ▲" : " ▼";
    }

    protected override Task OnInitializedAsync()
    {
        _serverUrlInput = Store.Preferences.ServerBaseUrl;
        _authKeyInput = Store.Preferences.TailscaleAuthKey;
        Tailscale.StateChanged += OnTailscaleStateChanged;
        MediaBridge.PlayPauseRequested += OnNativePlayPauseRequested;
        MediaBridge.TogglePlayPauseRequested += OnNativeTogglePlayPauseRequested;
        MediaBridge.StepStationRequested += OnNativeStepStationRequested;

        // Player mode never auto-starts music on launch
        if (IsPlayerMode)
        {
            Store.Preferences.PowerOn = false;
        }

        bool hadDiskCache = Engine.TryLoadFromDiskCache();
        if (hadDiskCache)
        {
            RefreshSnapshots();
            OnCatalogChangedForPlayer();
        }

        if (Tailscale.IsSupported && Tailscale.HasSavedSession(Store.Preferences.TailscaleAuthKey))
        {
            _ = AutoResumeTailscaleAndConnectAsync();
        }
        else
        {
            _ = InvokeAsync(() => ReloadCatalogAsync(showSpinner: !hadDiskCache));
        }

        return Task.CompletedTask;
    }

    private void OnTailscaleStateChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private void OnNativePlayPauseRequested(bool play)
    {
        _ = InvokeAsync(() => OnMediaPowerAsync(play));
    }

    private void OnNativeTogglePlayPauseRequested()
    {
        _ = InvokeAsync(async () =>
        {
            await TogglePowerAsync();
            StateHasChanged();
        });
    }

    private void OnNativeStepStationRequested(int direction)
    {
        _ = InvokeAsync(() => OnStepFrequencyAsync(direction));
    }

    private async Task AutoResumeTailscaleAndConnectAsync()
    {
        var fwdUrl = await Tailscale.TryAutoConnectAsync(
            Store.Preferences.ServerBaseUrl,
            Store.Preferences.TailscaleAuthKey);

        if (!string.IsNullOrWhiteSpace(fwdUrl))
        {
            Engine.RuntimeBaseUrlOverride = fwdUrl;
        }

        await InvokeAsync(() => ReloadCatalogAsync(showSpinner: !Engine.IsLoaded));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("radioAudio.init", _dotNetRef, new
            {
                preferOpus = IsAndroid,
                skipWebAudioCapture = IsAndroid
            });
            _jsInitialized = true;

            // Start playback immediately from local catalog cache if server URL is already a direct IP
            if (_activeStation is not null &&
                !(Tailscale.IsSupported && Tailscale.HasSavedSession(Store.Preferences.TailscaleAuthKey) && !Tailscale.IsConnected) &&
                IsDirectIpBaseUrl(Engine.EffectiveBaseUrl))
            {
                await SyncAudioAsync(staticBurstSec: 0, forceSync: true);
            }

            _tickCts = new CancellationTokenSource();
            _ = RunSecondTickerAsync(_tickCts.Token);
        }
    }

    private static bool IsDirectIpBaseUrl(string baseUrl) =>
        Uri.TryCreate(baseUrl, UriKind.Absolute, out var uri) &&
        System.Net.IPAddress.TryParse(uri.Host, out _);

    private void ScheduleCoverReveal(int trackId)
    {
        if (!IsAndroid)
        {
            _readyCoverTrackId = trackId;
            return;
        }

        if (_readyCoverTrackId == trackId || _scheduledCoverTrackId == trackId)
            return;

        _scheduledCoverTrackId = trackId;
        _coverDelayCts?.Cancel();
        _coverDelayCts?.Dispose();
        var cts = new CancellationTokenSource();
        _coverDelayCts = cts;

        _ = RevealCoverAfterDelayAsync(trackId, cts.Token);
    }

    private async Task RevealCoverAfterDelayAsync(int trackId, CancellationToken ct)
    {
        try
        {
            await Task.Delay(220, ct);
            await InvokeAsync(() =>
            {
                if (_activeStation?.CurrentTrack.Id == trackId)
                {
                    _readyCoverTrackId = trackId;
                    StateHasChanged();
                }
            });
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task RunSecondTickerAsync(CancellationToken ct)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        try
        {
            while (await timer.WaitForNextTickAsync(ct))
            {
                _clockText = DateTime.Now.ToString("HH:mm:ss");

                if (Tailscale.IsSupported && _awaitingBrowserLogin && !_pollingTailscale)
                {
                    _tsPollTicks++;
                    if (_tsPollTicks >= 2)
                    {
                        _tsPollTicks = 0;
                        _ = PollTailscaleLoginAsync(ct);
                    }
                }

                if (!_isOnline)
                {
                    _offlineRetryTicks++;
                    if (_offlineRetryTicks >= 5 && !_isLoadingCatalog && !Tailscale.IsBusy && !_serverPopoverOpen)
                    {
                        _offlineRetryTicks = 0;
                        _ = InvokeAsync(() => ReloadCatalogAsync(showSpinner: false));
                    }
                }

                if (!Engine.IsLoaded)
                {
                    await InvokeAsync(StateHasChanged);
                    continue;
                }

                await InvokeAsync(async () =>
                {
                    RefreshSnapshots();
                    if (IsPlayerMode)
                    {
                        await PlayerTickAsync();
                        StateHasChanged();
                        return;
                    }

                    if (_activeStation is not null)
                    {
                        if (_isOnline &&
                            (_activeStation.CurrentTrack.Id != _lastSyncedTrackId ||
                             !string.Equals(_activeStation.Name, _lastSyncedStation, StringComparison.OrdinalIgnoreCase)))
                        {
                            await SyncAudioAsync(staticBurstSec: 0, forceSync: true);
                        }
                        else if (IsAndroid &&
                                 _isOnline &&
                                 Store.Preferences.PowerOn &&
                                 _activeStation.NextTrack is { } next &&
                                 next.Id != _activeStation.CurrentTrack.Id &&
                                 next.Id != _lastPreloadedTrackId)
                        {
                            double remainingSec = _activeStation.DurationSec - _activeStation.ElapsedSec;
                            if (remainingSec is <= 9.0 and > 0.5)
                            {
                                _lastPreloadedTrackId = next.Id;
                                var preloadUrl = Engine.GetStreamUrl(next, startOffsetSec: 0, preferOpus: true);
                                await JS.InvokeVoidAsync("radioAudio.preloadNext", new
                                {
                                    trackId = next.Id,
                                    streamUrl = preloadUrl
                                });
                            }
                        }
                    }
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task PollTailscaleLoginAsync(CancellationToken ct)
    {
        if (_pollingTailscale)
            return;

        _pollingTailscale = true;
        try
        {
            var fwdUrl = await Tailscale.PollAndForwardIfRunningAsync(Store.Preferences.ServerBaseUrl, ct);
            if (!string.IsNullOrWhiteSpace(fwdUrl))
            {
                _awaitingBrowserLogin = false;
                Engine.RuntimeBaseUrlOverride = fwdUrl;
                _coverFailedTrackIds.Clear();
                await InvokeAsync(async () =>
                {
                    await ReloadCatalogAsync(showSpinner: true);
                    if (_isOnline)
                        _serverPopoverOpen = false;
                });
            }
        }
        finally
        {
            _pollingTailscale = false;
        }
    }

    private async Task StartTailscaleBrowserLoginAsync()
    {
        if (!Tailscale.IsSupported)
            return;

        if (_awaitingBrowserLogin && !string.IsNullOrWhiteSpace(Tailscale.AuthUrl))
        {
            await OpenAuthUrlAgainAsync();
            return;
        }

        var authUrl = await Tailscale.BeginInteractiveLoginAsync();
        if (Tailscale.IsConnected)
        {
            var fwdUrl = await Tailscale.PollAndForwardIfRunningAsync(Store.Preferences.ServerBaseUrl);
            if (!string.IsNullOrWhiteSpace(fwdUrl))
            {
                Engine.RuntimeBaseUrlOverride = fwdUrl;
                _coverFailedTrackIds.Clear();
                await ReloadCatalogAsync(showSpinner: true);
                if (_isOnline)
                    _serverPopoverOpen = false;
            }
            return;
        }

        if (!string.IsNullOrWhiteSpace(authUrl))
        {
            _awaitingBrowserLogin = true;
            try
            {
                await Launcher.Default.OpenAsync(new Uri(authUrl));
            }
            catch (Exception ex)
            {
                _connectionError = $"Не удалось открыть браузер: {ex.Message}";
            }
        }
        StateHasChanged();
    }

    private async Task OpenAuthUrlAgainAsync()
    {
        if (!string.IsNullOrWhiteSpace(Tailscale.AuthUrl))
        {
            try
            {
                await Launcher.Default.OpenAsync(new Uri(Tailscale.AuthUrl));
            }
            catch { }
        }
    }

    private async Task ConnectTailscaleAuthKeyAsync()
    {
        if (!Tailscale.IsSupported || string.IsNullOrWhiteSpace(_authKeyInput))
            return;

        Store.Preferences.TailscaleAuthKey = _authKeyInput.Trim();
        Store.Save();

        var fwdUrl = await Tailscale.ConnectWithAuthKeyAsync(
            Store.Preferences.TailscaleAuthKey,
            Store.Preferences.ServerBaseUrl);

        if (!string.IsNullOrWhiteSpace(fwdUrl))
        {
            _awaitingBrowserLogin = false;
            Engine.RuntimeBaseUrlOverride = fwdUrl;
            _coverFailedTrackIds.Clear();
            await ReloadCatalogAsync(showSpinner: true);
            if (_isOnline)
                _serverPopoverOpen = false;
        }
    }

    private async Task LogoutTailscaleAsync()
    {
        _awaitingBrowserLogin = false;
        Store.Preferences.TailscaleAuthKey = "";
        Store.Save();
        Engine.RuntimeBaseUrlOverride = null;
        MediaBridge.Stop();
        await Tailscale.LogoutAsync();
        _isOnline = false;
        StateHasChanged();
    }

    private async Task ReloadCatalogAsync(bool showSpinner)
    {
        if (_isLoadingCatalog)
            return;

        _isLoadingCatalog = true;
        if (showSpinner)
            StateHasChanged();

        try
        {
            if (Tailscale.IsSupported && Tailscale.IsConnected && string.IsNullOrWhiteSpace(Engine.RuntimeBaseUrlOverride))
            {
                var fwd = await Tailscale.PollAndForwardIfRunningAsync(Store.Preferences.ServerBaseUrl);
                if (!string.IsNullOrWhiteSpace(fwd))
                    Engine.RuntimeBaseUrlOverride = fwd;
            }

            var ok = await Engine.LoadFromServerAsync(Http);
            _isOnline = ok;
            _connectionError = ok ? null : "Каталог станций пуст.";
            RefreshSnapshots();
            OnCatalogChangedForPlayer();

            if (_jsInitialized && _activeStation is not null)
            {
                bool endpointChanged = !string.Equals(_lastSyncedBaseUrl, Engine.EffectiveBaseUrl, StringComparison.OrdinalIgnoreCase);
                await SyncAudioAsync(staticBurstSec: 0, forceSync: endpointChanged || _lastSyncedTrackId < 0);
            }
        }
        catch (Exception ex)
        {
            _isOnline = false;
            _connectionError = ex.Message;
        }
        finally
        {
            _isLoadingCatalog = false;
            StateHasChanged();
        }
    }

    private void RefreshSnapshots()
    {
        if (!Engine.IsLoaded)
            return;

        var now = DateTimeOffset.UtcNow;
        _allStations = Engine.GetAllStationsSnapshot(now, Store.Preferences.SortMode);
        _activeStation = Engine.GetStationSnapshot(Store.Preferences.ActiveStationName, now)
                         ?? _allStations.FirstOrDefault();

        if (_activeStation is not null)
        {
            ScheduleCoverReveal(_activeStation.CurrentTrack.Id);
        }
    }

    private async Task SyncAudioAsync(double staticBurstSec, bool forceSync = false)
    {
        if (IsPlayerMode)
        {
            await SyncPlayerAudioAsync(_playerPos);
            return;
        }

        if (!_jsInitialized || _activeStation is null)
            return;

        var tr = _activeStation.CurrentTrack;
        var baseUrl = Engine.EffectiveBaseUrl;
        if (!forceSync &&
            tr.Id == _lastSyncedTrackId &&
            string.Equals(_activeStation.Name, _lastSyncedStation, StringComparison.OrdinalIgnoreCase) &&
            string.Equals(baseUrl, _lastSyncedBaseUrl, StringComparison.OrdinalIgnoreCase) &&
            staticBurstSec <= 0)
        {
            return;
        }

        if (tr.Id != _lastSyncedTrackId || !string.Equals(_activeStation.Name, _lastSyncedStation, StringComparison.OrdinalIgnoreCase))
        {
            _lastPreloadedTrackId = -1;
        }

        _lastSyncedTrackId = tr.Id;
        _lastSyncedStation = _activeStation.Name;
        _lastSyncedBaseUrl = baseUrl;

        var stationLabel = $"{_activeStation.FrequencyMhz.ToString("0.0", CultureInfo.InvariantCulture)} FM · {_activeStation.Name}";
        var coverUrl = _coverFailedTrackIds.Contains(tr.Id) ? "" : Engine.GetCoverUrl(tr);

        if (MediaBridge.IsSupported)
        {
            MediaBridge.UpdatePlayback(new MediaPlaybackSnapshot(
                TrackId: tr.Id,
                TrackTitle: tr.DisplayTitle,
                TrackArtist: tr.Artist,
                StationLabel: stationLabel,
                CoverUrl: coverUrl,
                IsPlaying: Store.Preferences.PowerOn,
                ElapsedSec: _activeStation.ElapsedSec,
                DurationSec: _activeStation.DurationSec));
        }

        await JS.InvokeVoidAsync("radioAudio.syncBroadcast", new
        {
            trackId = tr.Id,
            trackTitle = tr.DisplayTitle,
            trackArtist = tr.Artist,
            stationLabel,
            coverUrl,
            directUrl = $"{baseUrl}/api/stream/{tr.Id}",
            transcodeBaseUrl = $"{baseUrl}/api/stream/{tr.Id}?transcode=1",
            opusBaseUrl = $"{baseUrl}/api/stream/{tr.Id}?transcode=1&format=opus",
            preferOpus = IsAndroid,
            isTranscoded = tr.IsAlac,
            targetElapsedSec = _activeStation.ElapsedSec,
            powerOn = Store.Preferences.PowerOn,
            volume = EffectiveVolume,
            staticFx = Store.Preferences.StaticFxEnabled,
            accentHex = _activeStation.AccentHex,
            bpm = tr.BpmRounded,
            energy = tr.EnergyPercent,
            staticBurstSec
        });
    }

