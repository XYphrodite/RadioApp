    private void OnCatalogChangedForPlayer()
    {
        RebuildAvailableArtists();
        RebuildPlayerList();
        if (IsPlayerMode)
            RestorePlayerTrack();
    }

    private void RebuildPlayerList()
    {
        if (!Engine.IsLoaded)
        {
            _filteredTracks = new();
            return;
        }

        IEnumerable<RadioTrack> q = Engine.LibraryTracks;
        if (!string.IsNullOrEmpty(_playerStation))
            q = q.Where(t => string.Equals(t.Station, _playerStation, StringComparison.OrdinalIgnoreCase));

        if (!string.IsNullOrEmpty(_playerArtist))
            q = q.Where(t => string.Equals(t.Artist, _playerArtist, StringComparison.OrdinalIgnoreCase));

        var words = _playerSearch.Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        if (words.Length > 0)
        {
            q = q.Where(t => words.All(w =>
                t.Artist.Contains(w, StringComparison.OrdinalIgnoreCase) ||
                t.Album.Contains(w, StringComparison.OrdinalIgnoreCase) ||
                t.DisplayTitle.Contains(w, StringComparison.OrdinalIgnoreCase)));
        }

        _filteredTracks = ApplySorting(q).ToList();
    }

    private IEnumerable<RadioTrack> ApplySorting(IEnumerable<RadioTrack> q)
    {
        var key = Store.Preferences.PlayerSortKey;
        var asc = Store.Preferences.PlayerSortAsc;

        return (key, asc) switch
        {
            ("artist", true) => q
                .OrderBy(t => string.IsNullOrWhiteSpace(t.Artist) ? 1 : 0)
                .ThenBy(t => t.Artist, StringComparer.CurrentCultureIgnoreCase)
                .ThenBy(t => string.IsNullOrWhiteSpace(t.Album) ? 1 : 0)
                .ThenBy(t => t.Album, StringComparer.CurrentCultureIgnoreCase)
                .ThenBy(t => t.DisplayTitle, StringComparer.CurrentCultureIgnoreCase),

            ("artist", false) => q
                .OrderBy(t => string.IsNullOrWhiteSpace(t.Artist) ? 1 : 0)
                .ThenByDescending(t => t.Artist, StringComparer.CurrentCultureIgnoreCase)
                .ThenByDescending(t => t.Album, StringComparer.CurrentCultureIgnoreCase)
                .ThenByDescending(t => t.DisplayTitle, StringComparer.CurrentCultureIgnoreCase),

            ("album", true) => q
                .OrderBy(t => string.IsNullOrWhiteSpace(t.Album) ? 1 : 0)
                .ThenBy(t => t.Album, StringComparer.CurrentCultureIgnoreCase)
                .ThenBy(t => string.IsNullOrWhiteSpace(t.Artist) ? 1 : 0)
                .ThenBy(t => t.Artist, StringComparer.CurrentCultureIgnoreCase)
                .ThenBy(t => t.DisplayTitle, StringComparer.CurrentCultureIgnoreCase),

            ("album", false) => q
                .OrderBy(t => string.IsNullOrWhiteSpace(t.Album) ? 1 : 0)
                .ThenByDescending(t => t.Album, StringComparer.CurrentCultureIgnoreCase)
                .ThenByDescending(t => t.Artist, StringComparer.CurrentCultureIgnoreCase)
                .ThenByDescending(t => t.DisplayTitle, StringComparer.CurrentCultureIgnoreCase),

            ("title", true) => q
                .OrderBy(t => t.DisplayTitle, StringComparer.CurrentCultureIgnoreCase)
                .ThenBy(t => t.Artist, StringComparer.CurrentCultureIgnoreCase),

            ("title", false) => q
                .OrderByDescending(t => t.DisplayTitle, StringComparer.CurrentCultureIgnoreCase)
                .ThenByDescending(t => t.Artist, StringComparer.CurrentCultureIgnoreCase),

            ("duration", true) => q
                .OrderBy(t => t.EffectiveDurationSec),

            ("duration", false) => q
                .OrderByDescending(t => t.EffectiveDurationSec),

            _ => q
        };
    }

    private void RestorePlayerTrack()
    {
        if (_playerTrack is not null || !Engine.IsLoaded)
            return;

        var saved = Store.Preferences.PlayerTrackId >= 0 ? Engine.FindTrack(Store.Preferences.PlayerTrackId) : null;
        if (saved is null)
            return;

        _playerTrack = saved;
        _playerPos = 0;
        _playerDur = saved.EffectiveDurationSec;
        BuildPlayerQueue(saved);
    }

    private void BuildPlayerQueue(RadioTrack start)
    {
        IReadOnlyList<RadioTrack> src = _filteredTracks.Any(t => t.Id == start.Id)
            ? _filteredTracks
            : Engine.LibraryTracks;

        var list = new List<RadioTrack>(src);
        if (Store.Preferences.PlayerShuffle)
        {
            for (int i = list.Count - 1; i > 0; i--)
            {
                int j = Random.Shared.Next(i + 1);
                (list[i], list[j]) = (list[j], list[i]);
            }

            int at = list.FindIndex(t => t.Id == start.Id);
            if (at > 0)
                (list[0], list[at]) = (list[at], list[0]);
        }

        _playerQueue = list;
        _playerIndex = Math.Max(0, list.FindIndex(t => t.Id == start.Id));
    }

    private async Task PlayFromListAsync(RadioTrack t)
    {
        if (_playerTrack is not null && _playerTrack.Id == t.Id)
        {
            await TogglePowerAsync();
            return;
        }

        await PlayTrackAsync(t, rebuildQueue: true);
    }

    private async Task PlayTrackAsync(RadioTrack t, bool rebuildQueue)
    {
        int idx = rebuildQueue ? -1 : _playerQueue.FindIndex(x => x.Id == t.Id);
        if (idx < 0)
            BuildPlayerQueue(t);
        else
            _playerIndex = idx;

        _playerTrack = t;
        _playerPos = 0;
        _playerDur = t.EffectiveDurationSec;
        _isSeeking = false;
        Store.Preferences.PlayerTrackId = t.Id;
        Store.Preferences.PowerOn = true;
        Store.Save();
        await SyncPlayerAudioAsync(0);
    }

    private async Task PlayerStepAsync(int dir)
    {
        if (_playerQueue.Count == 0)
        {
            if (_playerTrack is null && _filteredTracks.Count > 0)
                await PlayTrackAsync(_filteredTracks[0], rebuildQueue: true);
            return;
        }

        if (dir < 0 && _playerPos > 3.0)
        {
            await SeekPlayerAsync(0);
            return;
        }

        int n = _playerQueue.Count;
        int next = ((_playerIndex + dir) % n + n) % n;
        await PlayTrackAsync(_playerQueue[next], rebuildQueue: false);
    }

    private async Task PlayerTrackEndedAsync()
    {
        if (_playerTrack is null || _playerQueue.Count == 0)
            return;

        var repeat = Store.Preferences.PlayerRepeat;
        if (repeat == "one")
        {
            await SeekPlayerAsync(0);
            return;
        }

        if (repeat == "off" && _playerIndex + 1 >= _playerQueue.Count)
        {
            _playerPos = 0;
            Store.Preferences.PowerOn = false;
            Store.Save();
            await SyncPlayerAudioAsync(0);
            return;
        }

        await PlayerStepAsync(1);
    }

    private async Task SeekPlayerAsync(double sec)
    {
        if (!_jsInitialized || _playerTrack is null)
            return;

        double max = _playerDur > 1 ? _playerDur - 0.5 : double.MaxValue;
        _playerPos = Math.Clamp(sec, 0, max);
        await JS.InvokeVoidAsync("radioAudio.seekTo", _playerPos);
        UpdatePlayerBridge();
    }

    private void OnSeekInput(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out var v))
        {
            _isSeeking = true;
            _seekPreview = v;
        }
    }

    private async Task OnSeekCommitAsync(ChangeEventArgs e)
    {
        _isSeeking = false;
        if (double.TryParse(e.Value?.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out var v))
            await SeekPlayerAsync(v);
    }

    private void TogglePlayerShuffle()
    {
        Store.Preferences.PlayerShuffle = !Store.Preferences.PlayerShuffle;
        Store.Save();
        if (_playerTrack is not null)
            BuildPlayerQueue(_playerTrack);
    }

    private void CyclePlayerRepeat()
    {
        Store.Preferences.PlayerRepeat = Store.Preferences.PlayerRepeat switch
        {
            "all" => "one",
            "one" => "off",
            _ => "all"
        };
        Store.Save();
    }

    private void ShowMorePlayerTracks() => _playerShown += PlayerPageSize;

    private void UpdatePlayerBridge()
    {
        if (!MediaBridge.IsSupported)
            return;

        var tr = _playerTrack;
        if (tr is null)
        {
            MediaBridge.Stop();
            return;
        }

        MediaBridge.UpdatePlayback(new MediaPlaybackSnapshot(
            TrackId: tr.Id,
            TrackTitle: tr.DisplayTitle,
            TrackArtist: tr.Artist,
            StationLabel: string.IsNullOrWhiteSpace(tr.Album) ? "Медиаплеер" : tr.Album,
            CoverUrl: _coverFailedTrackIds.Contains(tr.Id) ? "" : Engine.GetCoverUrl(tr),
            IsPlaying: Store.Preferences.PowerOn,
            ElapsedSec: _playerPos,
            DurationSec: _playerDur));
    }

    private async Task SyncPlayerAudioAsync(double startSec)
    {
        if (!_jsInitialized)
            return;

        // Resume pressed with nothing selected yet: pick the first track of the list
        if (_playerTrack is null && Store.Preferences.PowerOn && _filteredTracks.Count > 0)
        {
            _playerTrack = _filteredTracks[0];
            _playerPos = 0;
            _playerDur = _playerTrack.EffectiveDurationSec;
            Store.Preferences.PlayerTrackId = _playerTrack.Id;
            BuildPlayerQueue(_playerTrack);
            startSec = 0;
        }

        var tr = _playerTrack;
        if (tr is null)
        {
            UpdatePlayerBridge();
            await JS.InvokeVoidAsync("radioAudio.syncBroadcast", new
            {
                trackId = -1,
                directUrl = "",
                powerOn = false,
                volume = EffectiveVolume,
                staticFx = false,
                accentHex = PlayerAccent,
                freePlay = true
            });
            return;
        }

        var baseUrl = Engine.EffectiveBaseUrl;
        var coverUrl = _coverFailedTrackIds.Contains(tr.Id) ? "" : Engine.GetCoverUrl(tr);
        UpdatePlayerBridge();

        await JS.InvokeVoidAsync("radioAudio.syncBroadcast", new
        {
            trackId = tr.Id,
            trackTitle = tr.DisplayTitle,
            trackArtist = tr.Artist,
            stationLabel = string.IsNullOrWhiteSpace(tr.Album) ? "Медиаплеер" : tr.Album,
            coverUrl,
            directUrl = $"{baseUrl}/api/stream/{tr.Id}",
            transcodeBaseUrl = $"{baseUrl}/api/stream/{tr.Id}?transcode=1",
            opusBaseUrl = $"{baseUrl}/api/stream/{tr.Id}?transcode=1&format=opus",
            preferOpus = IsAndroid,
            isTranscoded = tr.IsAlac,
            targetElapsedSec = startSec,
            powerOn = Store.Preferences.PowerOn,
            volume = EffectiveVolume,
            staticFx = false,
            accentHex = PlayerAccent,
            bpm = tr.BpmRounded,
            energy = tr.EnergyPercent,
            staticBurstSec = 0,
            freePlay = true
        });
    }

    private async Task PlayerTickAsync()
    {
        if (!_jsInitialized || _playerTrack is null || _isSeeking)
            return;

        try
        {
            var p = await JS.InvokeAsync<PlayerPosition>("radioAudio.getPosition");
            if (p is null)
                return;

            _playerPos = Math.Max(0, p.Pos);
            if (p.Dur > 1)
                _playerDur = p.Dur;
        }
        catch
        {
        }
    }

    private string GetLiveDotClass()
    {
        if (!_isOnline) return "offline";
        return Store.Preferences.PowerOn ? "" : "muted";
    }

    private string GetServerHostLabel()
    {
        if (Tailscale.IsSupported && Tailscale.IsConnected && !string.IsNullOrWhiteSpace(Engine.RuntimeBaseUrlOverride))
        {
            if (Uri.TryCreate(Store.Preferences.ServerBaseUrl, UriKind.Absolute, out var tsUri))
                return $"Tailscale · {tsUri.Host}";
            return "Tailscale";
        }

        if (Uri.TryCreate(Store.Preferences.ServerBaseUrl, UriKind.Absolute, out var uri))
            return $"фонотека {uri.Host}";
        return "локальная фонотека";
    }

    private static string FreqToPctCss(double freq)
    {
        double pct = Math.Clamp((freq - FreqMin) / (FreqMax - FreqMin) * 100.0, 0.0, 100.0);
        return pct.ToString("0.00", CultureInfo.InvariantCulture) + "%";
    }

    private static string FormatTime(double sec)
    {
        int s = Math.Max(0, (int)Math.Floor(sec));
        int m = s / 60;
        int r = s % 60;
        return $"{m:D2}:{r:D2}";
    }

    private static string FormatInt(int n) =>
        n.ToString("N0", CultureInfo.GetCultureInfo("ru-RU"));

    public ValueTask DisposeAsync()
    {
        Tailscale.StateChanged -= OnTailscaleStateChanged;
        MediaBridge.PlayPauseRequested -= OnNativePlayPauseRequested;
        MediaBridge.TogglePlayPauseRequested -= OnNativeTogglePlayPauseRequested;
        MediaBridge.StepStationRequested -= OnNativeStepStationRequested;
        _coverDelayCts?.Cancel();
        _coverDelayCts?.Dispose();
        _tickCts?.Cancel();
        _tickCts?.Dispose();
        _dotNetRef?.Dispose();
        return ValueTask.CompletedTask;
    }
}
